{
  "namespace": "hud",
  "ahud_root": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - 'ahud:') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "ahud_text": {
          "type": "label",
          "text": "#text",
          "shadow": true,
          "text_alignment": "left",
          "font_scale_factor": 1,
          "line_padding": 3,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            6,
            0
          ],
          "size": [
            "default",
            "default"
          ],
          "bindings": [
            {
              "binding_name": "#hud_title_text_string",
              "binding_condition": "always"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#hud_title_text_string - 'ahud:')",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "ahud_factory": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "layer": 20,
    "factory": {
      "name": "hud_title_text_factory",
      "control_ids": {
        "hud_title_text": "ahud_root@hud.ahud_root"
      }
    }
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ahud_factory@hud.ahud_factory": {}
          }
        ]
      }
    ]
  },
  "hud_title_text/title_frame": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - 'ahud:') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },
  "hud_title_text/subtitle_frame": {
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - 'ahud:') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  }
}
